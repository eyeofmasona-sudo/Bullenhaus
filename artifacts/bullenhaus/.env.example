# ============================================================================
# Bullenhaus — environment variables
# Copy to `.env` for local dev, or set these in your hosting provider
# (e.g. Vercel Project Settings → Environment Variables) for production.
# ============================================================================

# ----------------------------------------------------------------------------
# Frontend (Vite) — exposed to the browser. Use the PUBLISHABLE/ANON key only,
# never the service-role key. Required: the app throws at startup if unset.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Optional alias accepted as a fallback if PUBLISHABLE_KEY is not set:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================================
# Supabase Edge Function secrets — NOT bundled into the frontend.
# Set with: supabase secrets set KEY=value
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
#  automatically by the Supabase platform and do not need to be set manually.)
# ============================================================================

# ai-chat / ai-status — OpenRouter API key for AI chat completions.
OPENROUTER_API_KEY=sk-or-...
AI_PROVIDER=openrouter
AI_OPENROUTER_ENABLED=true
AI_PRIMARY_MODEL=deepseek/deepseek-chat-v3.1
AI_FALLBACK_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_OPENROUTER_ALLOW_FALLBACKS=true
AI_OPENROUTER_SORT=price
AI_OPENROUTER_DATA_COLLECTION=deny
# Optional: restrict OpenRouter routing to Zero Data Retention endpoints.
# AI_OPENROUTER_ZDR=true
AI_REQUEST_TIMEOUT_MS=30000

# crm-sync — outbound CRM integration endpoint + key.
CRM_API_URL=https://your-crm-endpoint.example.com
CRM_API_KEY=your-crm-api-key

# All edge functions — lock browser CORS to your production origin.
# Defaults to "*" (any origin) if unset. Set to your domain in production
# to prevent other sites from proxying requests through your functions.
# ALLOWED_ORIGIN=https://your-domain.com
